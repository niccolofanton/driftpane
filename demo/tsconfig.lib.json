{
	"//": "Builds the library (src/) into demo/lib as ES modules for the demo.",
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"sourceMap": true,
		"rootDir": "../src",
		"outDir": "./lib"
	},
	"include": ["../src/**/*.ts"]
}
